[Unit]
Description=Marble status dashboard - HTML generator
After=local-fs.target
Before=marble-dashboard-kiosk.service

[Service]
Type=simple
Environment=INTERVAL=2
Environment=BRIGHTNESS=45
ExecStart=/bin/sh -c 'while :; do /usr/local/bin/marble-dashboard.sh || true; sleep 2; done'
Restart=always
RestartSec=5
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target

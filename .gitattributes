# 统一换行符：脚本要在 Linux/手机/WSL 里跑，必须 LF
# 不加这个，Windows 上 checkout 会变成 CRLF，报 "bad interpreter: /bin/sh^M"
* text=auto eol=lf

*.sh            text eol=lf
*.service       text eol=lf
*.conf          text eol=lf
*.md            text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# 没有扩展名的可执行脚本
marble-install  text eol=lf
out/marble-install text eol=lf

# 二进制
*.img   binary
*.apk   binary
*.zip   binary
*.png   binary
*.jpg   binary
